  <string name="pref_title_color_black_level">黑电平</string>
  <string name="pref_title_color_white_level">白电平</string>
  <string name="pref_title_color_saturation">饱和度</string>
  <string name="pref_title_color_processing_enabled">色彩处理</string>
  <string name="pref_group_color_per_channel">分通道校正（R/G/B）</string>
  <string name="pref_title_color_brightness_r">红色亮度</string>
  <string name="pref_title_color_brightness_g">绿色亮度</string>
  <string name="pref_title_color_brightness_b">蓝色亮度</string>
  <string name="pref_title_color_gamma_r">红色伽马</string>
  <string name="pref_title_color_gamma_g">绿色伽马</string>
  <string name="pref_summary_color_gamma">伽马低于 100% 会压暗中间调：颜色更浓郁，暗灰（包括视频的黑边）不再发亮。45% 相当于伽马 2.2，适合颜色发白的灯带作为起点。高于 100% 则中间调更亮。</string>
  <string name="pref_title_color_gamma_b">蓝色伽马</string>
  <string name="pref_color_preview_title">预览（色彩处理后）</string>
  <string name="pref_color_preview_hint">反映将发送到灯带的内容。主屏幕上的动画不会使用这些设置。</string>
  <string name="pref_group_border_detection">黑边（信箱）检测</string>
  <string name="pref_title_border_detection_enabled">自动检测信箱黑边</string>
  <string name="pref_summary_border_detection_enabled">忽略画面周围的黑边（适用于 16:9、1.85:1、2.39:1 内容）。默认关闭。</string>
  <string name="pref_title_border_threshold">黑色阈值（RGB 0–64）</string>
  <string name="pref_title_border_check_interval">检测间隔（帧）</string>
  <string name="pref_title_border_ignore_subtitles">忽略底部黑边中的字幕</string>
  <string name="pref_summary_border_ignore_subtitles">从顶部边缘取黑边高度，底部只检查角落，这样黑边中的字幕不会缩小裁切。暗场景会保持裁切。覆盖在画面上的字幕仍会传到 LED。</string>
  <string name="pref_group_camera_idle">摄像头睡眠模式</string>
  <string name="pref_title_camera_idle_enabled">启用睡眠模式</string>
  <string name="pref_summary_camera_idle_enabled">摄像头捕获不会从电视收到待机信号，因此关机屏幕会继续把传感器噪点流到灯带。启用后，画面变黑时 LED 会关闭，帧传输暂停，直到画面恢复。默认禁用。</string>
  <string name="pref_title_camera_idle_timeout">睡眠延迟（秒）</string>
  <string name="pref_title_camera_idle_dark_level">空白屏幕阈值（0–96）</string>
  <string name="pref_title_camera_idle_motion_level">运动灵敏度阈值（1–64）</string>
  <string name="pref_title_camera_idle_static">静态画面时睡眠</string>
  <string name="pref_summary_camera_idle_static">启用后，如果画面停止变化（例如暂停的视频或静态菜单），帧传输也会暂停；灯带会保留最后显示的颜色。默认禁用，因为长时间静态场景会冻结灯带的颜色。</string>
